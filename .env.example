# Ключ доступу до POST /check-document (заголовок X-API-Key). Згенерувати:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Який тунель запускати: quick (тимчасова адреса trycloudflare.com) або named (власний домен)
COMPOSE_PROFILES=quick

# Лише для COMPOSE_PROFILES=named: токен тунелю з Cloudflare Zero Trust -> Networks -> Tunnels
TUNNEL_TOKEN=
